{
  "version": 2,
  "builds": [
    {
      "src": "main.go",
      "use": "@vercel/go"
    },
    {
      "src": "html/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/html/(.*)",
      "dest": "/html/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.go"
    }
  ]
}
